{
  "name": "mafiadj",
  "version": "1.0.0",
  "description": "A self-hosted Discord music bot for personal use.",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": "node_modules/**/*",
    "targets": [
      "node20-win-x64"
    ]
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "deploy": "ts-node src/bot/deploy-commands.ts",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "discord",
    "music",
    "bot",
    "typescript"
  ],
  "author": "MafiaDJ",
  "license": "ISC",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.9",
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "libsodium-wrappers": "^0.8.2",
    "pino": "^8.0.0",
    "pino-pretty": "^10.0.0",
    "spotify-web-api-node": "^5.0.0",
    "ws": "^8.20.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/better-sqlite3": "^7.0.0",
    "@types/spotify-web-api-node": "^5.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.0.0",
    "nodemon": "^3.0.0"
  }
}
