# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Optional Spotify catalog search. Spotify links fall back to YouTube by default.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# High-risk, instance-owner Spotify integration. Disabled unless all values are set.
SPOTIFY_OWNER_SYNC_AVAILABLE=false
SPOTIFY_OWNER_SYNC_RISK_ACKNOWLEDGED=false
SPOTIFY_REFRESH_TOKEN=

# Executables
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
YTDLP_MAX_CONCURRENT=3

# Optional yt-dlp PO-token provider URL. Prefer this over account cookies.
YOUTUBE_POT_PROVIDER_URL=
YOUTUBE_COOKIES_PATH=data/cookies.txt

# Optional comma-separated HTTPS hostnames for direct audio URLs.
DIRECT_MEDIA_HOSTS=

# Playback
LOG_LEVEL=info

# Web dashboard
DASHBOARD_ENABLED=false
DASHBOARD_PORT=3000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_SESSION_SECRET=
DISCORD_CLIENT_SECRET=
DASHBOARD_REDIRECT_URI=
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_TRUST_PROXY=false
# Compose sets this for its host-loopback-only port. Do not use it on a public bind.
DASHBOARD_ALLOW_INSECURE_HTTP=false
