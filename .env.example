# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Spotify (Web API)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Spotify (Librespot - Account)
SPOTIFY_USERNAME=
SPOTIFY_PASSWORD=

# Paths (Optional)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
LIBRESPOT_PATH=librespot
# Optional comma-separated HTTPS hostnames for direct audio URLs.
# Leave blank to allow only YouTube, Spotify, and SoundCloud.
DIRECT_MEDIA_HOSTS=

# Logging
LOG_LEVEL=info

# Web Dashboard (required only when DASHBOARD_ENABLED=true)
DASHBOARD_ENABLED=false
DASHBOARD_PORT=3000
# Generate with: openssl rand -base64 48
DASHBOARD_SESSION_SECRET=
DISCORD_CLIENT_SECRET=
# Use the externally visible HTTPS URL in production.
DASHBOARD_REDIRECT_URI=
# Set true only when an HTTPS reverse proxy terminates TLS in front of the app.
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_TRUST_PROXY=false
